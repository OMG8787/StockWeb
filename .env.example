# AI providers（聊天問答、每日快報、今日建議、新聞摘要共用，見 src/lib/ai/provider.ts）。
# 全部都是選填——一個都沒設定時，/api/ask 仍可運作，只是改回傳用原始報價/
# 技術資料組成的固定格式回答。
#
# 有設定的會依序嘗試：Gemini → NVIDIA → Groq → Anthropic（前一家 429/逾時/
# 錯誤/空白/截斷就自動換下一家，剛失敗的會暫時跳過幾分鐘）。

# Google Gemini (recommended, free tier, no credit card required):
# get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# NVIDIA NIM（免費，Gemini 撞額度時的第一備援，接得住所有長提示詞；回覆比
# Gemini 慢，深度分析約 25~37 秒）：https://build.nvidia.com 申請
NVIDIA_API_KEY=
# 選填：覆寫 NVIDIA 模型（預設 nvidia/nemotron-3-super-120b-a12b）
# NVIDIA_MODEL=

# Groq（免費，約 1 秒回覆，但免費層每分鐘只有 8,000 token，只接得住小請求，
# 排在備援最後）：https://console.groq.com/keys 申請
GROQ_API_KEY=
# 選填：覆寫 Groq 模型（預設 openai/gpt-oss-120b）
# GROQ_MODEL=

# 選填：整個覆寫嘗試順序（逗號分隔：gemini,nvidia,groq,anthropic），沒列到的
# 供應商不會被呼叫。維運或測試備援鏈用，平常不用設。
# AI_PROVIDER_ORDER=

# Anthropic Claude (paid, usage-based): get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: protects /api/cron/daily-brief (the Vercel Cron trigger that
# pre-warms the daily brief). Vercel sends this automatically as
# `Authorization: Bearer <secret>` when set; if you don't set it, the route
# is unauthenticated (harmless — a manual hit just regenerates the brief
# early).
CRON_SECRET=

# Optional: shared cache (see lib/data/cache.ts). Without these, every
# serverless instance keeps its own in-memory cache (works fine, just less
# effective). Set either pair — whichever your Redis provider gives you:
#   - Vercel Marketplace "Redis" integration (Project → Storage → Redis):
KV_REST_API_URL=
KV_REST_API_TOKEN=
#   - or a directly-connected Upstash Redis database:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: canonical site URL used for SEO metadata, Open Graph tags, and
# the sitemap. Defaults to the current Vercel deployment URL if unset.
NEXT_PUBLIC_SITE_URL=

# Optional: Google 登入（帳號系統）。三個都沒設定時，網站正常運作，只是不會
# 顯示登入按鈕；設定後才會啟用「登入以跨裝置同步自選股」。
# 1. 在 https://console.cloud.google.com/apis/credentials 建立 OAuth 2.0 用戶端 ID
#    （應用程式類型：網頁應用程式），已授權的重新導向 URI 填：
#    https://你的網域/api/auth/callback/google（本機開發則是
#    http://localhost:3000/api/auth/callback/google）
# 2. 把用戶端 ID / 密碼填在這裡：
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# 3. AUTH_SECRET：任意隨機字串，用來加密登入 session，可用
#    `npx auth secret` 產生
AUTH_SECRET=

# 網站進入密碼（僅供家人/私人使用時的簡單門檔，不是正式帳號系統）。設定後，
# 任何人第一次造訪網站都要先輸入這組密碼才能進去，輸入一次後用瀏覽器 cookie
# 記住一年，之後不用再輸入。不設定的話會用程式碼裡寫死的預設值（見
# src/app/api/unlock/route.ts）——這個 repo 是公開的，所以預設值不是真正的
# 秘密，正式使用請務必在 Vercel 專案的 Environment Variables 設定這個變數
# 蓋掉預設值。
SITE_PASSWORD=

# ---- 選用：免費資料 API（2026-09-30 新增）。全部都可以不設定，沒設定時網站維持原本行為 ----
# FRED（美國聖路易聯準銀行）總體經濟資料：首頁「美國總體經濟」卡片＋AI 大盤概況的總經
# 數字（利率、美債殖利率、CPI、失業率、美元、VIX、原油）。沒設定時卡片不顯示。
# 免費申請：https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# Finnhub 美股資料：Yahoo 財報/基本面抓不到時的備援，並補充美股個股新聞給 AI。
# 免費方案 60 次/分鐘，台股沒有資料。免費申請：https://finnhub.io/register
FINNHUB_API_KEY=
# Adanos 美股社群情緒（Reddit／X／財經新聞）：美股個股頁「社群情緒」小卡＋AI 個股分析。
# 免費方案每個帳單週期僅 250 次，程式內建護欄（Redis 計數：日 12／月 240、伺服器剩餘 ≤10 即停），
# 只在正式環境美股盤中約 40 分鐘打一次批次熱門榜。沒設定時小卡不顯示。https://adanos.org/register
ADANOS_API_KEY=
# 本機開發預設不打 Adanos（避免燒額度）；確定要本機測試才設 1。
# ADANOS_ALLOW_LOCAL=
